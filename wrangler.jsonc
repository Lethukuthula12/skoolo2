// Cloudflare Worker serving the parent app as static assets.
// Used by the default deploy command `npx wrangler deploy` in Cloudflare Workers Builds.
{
  "name": "skoolo-app",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/dist/parent-app/browser",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
