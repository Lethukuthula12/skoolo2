{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["cypress", "node"], "noEmit": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true
  },
  "include": ["cypress.config.ts", "step-definitions/**/*.ts", "support/**/*.ts"]
}
